# Application Configuration
APP_NAME=Education Intelligence & Content Orchestration Platform
APP_VERSION=1.0.0
DEBUG=False

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./academian_platform.db
DATABASE_ECHO=False

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.7

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Logging Configuration
LOG_LEVEL=INFO

# Feature Flags
ENABLE_HUMAN_REVIEW=True
ENABLE_MONITORING=True
MAX_CONCURRENT_AGENTS=5

# Timeouts (seconds)
AGENT_TIMEOUT=300
WORKFLOW_TIMEOUT=600

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password
SENDER_NAME=Academian

# Frontend URLs
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_URL=http://localhost:3000/auth/reset-password
EMAIL_VERIFICATION_URL=http://localhost:3000/auth/verify-email
